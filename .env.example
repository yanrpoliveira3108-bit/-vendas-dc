# ── Skylers GenPago Bot · configuração ────────────────────────────────
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA compartilhe o arquivo .env nem o token!

# Token do bot (Discord Developer Portal → Bot → Reset Token).
DISCORD_TOKEN=coloque_seu_token_aqui

# (Opcional) Restringe o bot a um único canal do servidor.
# Deixe vazio para liberar em qualquer canal. Use o ID numérico do canal.
CANAL_GENPAGO=

# (Opcional) ID de um servidor de testes para os comandos "/"
# aparecerem na hora. Deixe vazio para comandos globais (até 1h).
TEST_GUILD_ID=

# Tempo de espera entre /gerar por usuário (segundos).
COOLDOWN_SEGUNDOS=30

# Validade das contas fictícias registradas (horas).
VALIDADE_HORAS=24
